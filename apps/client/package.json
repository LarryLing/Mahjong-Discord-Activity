{
  "name": "@mahjong/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tunnel": "dotenv -e .env.development -- cross-var cloudflared tunnel run --token %CLOUDFLARED_TUNNEL_TOKEN%",
    "tunnel:token": "dotenv -e .env.development -- cross-var echo %CLOUDFLARED_TUNNEL_TOKEN%",
    "dev": "vite",
    "dev:tunnel": "concurrently \"vite\" \"pnpm tunnel\"",
    "build": "pnpm --filter @mahjong/shared run build && tsc -b ../server && tsc -b && vite build",
    "preview": "vite preview",
    "preview:tunnel": "concurrently \"vite preview\" \"pnpm tunnel\"",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "dependencies": {
    "@mahjong/shared": "workspace:*",
    "@base-ui/react": "^1.7.0",
    "@colyseus/react": "^0.1.17",
    "@colyseus/sdk": "^0.17.43",
    "@discord/embedded-app-sdk": "^2.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mahjong/ts-config": "workspace:*",
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "2.5.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.4",
    "cross-var": "^1.1.0",
    "dotenv-cli": "^11.0.0",
    "globals": "^17.9.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.1"
  }
}
