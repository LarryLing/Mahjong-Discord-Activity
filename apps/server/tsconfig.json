{
  "extends": "@mahjong/ts-config/base.json",
  "include": [
    "src",
    "test"
  ],
  "compilerOptions": {
    /* Type Checking */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Modules */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* Emit */
    "outDir": "build",
    /* Javascript Support */
    "allowJs": true,
    /* Interop Constraints */
    "esModuleInterop": true,
    /* Language and Environment */
    "experimentalDecorators": true,
    "target": "ESNext",
    "useDefineForClassFields": false,
  }
}
