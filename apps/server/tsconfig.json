{
  "extends": "@mahjong/ts-config/base.json",
  "include": [
    "src",
    "test"
  ],
  "compilerOptions": {
    /* Type Checking */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Modules */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* Emit */
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "build",
    "noEmit": false,
    /* Javascript Support */
    "allowJs": true,
    /* Interop Constraints */
    "esModuleInterop": true,
    /* Language and Environment */
    "experimentalDecorators": true,
    "target": "ESNext",
    "useDefineForClassFields": false,
    /* Projects */
    "composite": true,
  }
}
