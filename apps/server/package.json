{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 20.9.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "mocha -r tsx test/**.test.ts --exit --timeout 15000",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "bugs": {
    "url": "https://github.com/colyseus/create-colyseus/issues"
  },
  "homepage": "https://github.com/colyseus/create-colyseus#readme",
  "dependencies": {
    "@colyseus/schema": "^4.0.30",
    "@colyseus/tools": "^0.17.20",
    "@t3-oss/env-core": "^0.13.11",
    "colyseus": "^0.17.10",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@colyseus/loadtest": "^0.17.8",
    "@colyseus/sdk": "^0.17.43",
    "@colyseus/testing": "^0.17.11",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "mocha": "^11.8.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2"
  }
}
