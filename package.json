{
  "name": "Mahjong-Discord-Activity",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "build:client": "pnpm --filter @mahjong/client run build",
    "build:server": "pnpm --filter @mahjong/server run build",
    "build:shared": "pnpm --filter @mahjong/shared run build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7"
  },
  "keywords": [
    "monorepo",
    "react",
    "tailwindcss",
    "shadcn-ui"
  ],
  "author": "Larry Ling",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1"
}
