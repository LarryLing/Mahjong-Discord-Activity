{
  "extends": "@mahjong/ts-config/base.json",
  "include": [
    "src/**/*"
  ],
  "compilerOptions": {
    /* Modules */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    /* Emit */
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
  }
}
