{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*"],
  "compilerOptions": {
    /* Modules */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    /* Emit */
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    /* Language and Environment */
    "lib": ["ES2023"],
    /* Projects */
    "composite": true,
    "target": "es2023",
    "types": []
  }
}
